<Window x:Class="LanShare.Windows.WebTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="LanShare · 4자리 코드 / QR 전송" Height="820" Width="1100" MinHeight="620" MinWidth="760"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12">
            <Button Content="닫기" DockPanel.Dock="Right" Padding="16,7" Click="Close_Click" />
            <TextBlock Text="웹과 같은 4자리 코드 또는 QR로 연결" VerticalAlignment="Center" FontWeight="SemiBold" />
        </DockPanel>
        <wv2:WebView2 x:Name="Browser" />
    </DockPanel>
</Window>
