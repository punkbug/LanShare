<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LanShare</AssemblyName>
    <RootNamespace>LanShare.Windows</RootNamespace>
    <ApplicationIcon>LanShare.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="LanShare.ico" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>
</Project>
