<Window x:Class="LanShare.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanShare" Icon="LanShare.ico" Height="620" Width="900" MinHeight="540" MinWidth="760"
        Background="#F6F8FC" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="20">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="⇅  LanShare" FontSize="26" FontWeight="Bold" Foreground="#182740" />
                    <TextBlock Text="같은 네트워크에서 바로 전송" Margin="0,4,0,18" Foreground="#68758B" />
                    <Button Content="🌐 4자리 코드 / QR로 전송" Margin="0,0,0,14" Padding="10,8" Click="WebTransfer_Click" />
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="주변 기기" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="새로고침" DockPanel.Dock="Right" Padding="10,5" Click="Refresh_Click" />
                    </DockPanel>
                </StackPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Text="주변 기기를 검색 중입니다…"
                           TextWrapping="Wrap" Margin="0,14,0,0" FontSize="12" Foreground="#68758B" />
                <ListBox x:Name="PeersList" BorderThickness="0" Background="Transparent" SelectionChanged="PeersList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Margin="0,2" CornerRadius="8" Background="#F1F4FA">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#182740" />
                                    <TextBlock Text="{Binding Address}" FontSize="11" Foreground="#68758B" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="28">
            <StackPanel>
                <TextBlock Text="파일 보내기" FontSize="26" FontWeight="Bold" Foreground="#182740" />
                <TextBlock Text="전송은 같은 로컬 네트워크에서 기기끼리 직접 이뤄집니다." Margin="0,8,0,22"
                           Foreground="#68758B" TextWrapping="Wrap" />
                <Button x:Name="ChooseButton" Height="170" Click="ChooseFile_Click" Background="#F7F9FD"
                        BorderBrush="#CBD4E2" BorderThickness="1" AllowDrop="True" Drop="FileDrop_Drop" DragOver="FileDrop_DragOver">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="＋" FontSize="38" HorizontalAlignment="Center" Foreground="#2457D6" />
                        <TextBlock x:Name="SelectedFileText" Text="파일 선택 또는 여기로 끌어 놓기" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedFileSize" Text="" FontSize="12" Foreground="#68758B" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="SendButton" Content="선택한 기기로 보내기" Margin="0,18,0,0" Padding="12,10"
                        Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold" IsEnabled="False" Click="Send_Click" />
                <StackPanel x:Name="TransferPanel" Visibility="Collapsed" Margin="0,22,0,0">
                    <TextBlock x:Name="TransferLabel" FontWeight="SemiBold" />
                    <ProgressBar x:Name="TransferProgress" Height="12" Margin="0,9,0,5" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="TransferDetails" FontSize="12" Foreground="#68758B" />
                </StackPanel>
                <Border Background="#FFF3DB" CornerRadius="8" Padding="12" Margin="0,24,0,0">
                    <TextBlock Text="개발용 프로토콜 · 현재 전송은 암호화되지 않습니다. 신뢰하는 네트워크에서만 사용하세요."
                               Foreground="#805000" FontSize="12" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
